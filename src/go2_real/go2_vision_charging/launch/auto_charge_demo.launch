<launch>
    <!-- 加载参数 -->
    <rosparam command="load" file="$(find go2_vision_charging)/config/charging_params.yaml" />
    
    <!-- 相机节点 -->
    <node pkg="video_stream_opencv" type="video_stream" name="camera" output="screen" ns="camera">
        <param name="camera_name" value="head_camera" />
        <param name="video_stream_provider" value="rtsp://admin:Basic@2021@192.168.168.25:554/cam/realmonitor?channel=1&amp;subtype=0" />
        <param name="set_camera_fps" value="false" />
        <param name="buffer_queue_size" value="1" />
        <param name="fps" value="30" />
        <param name="frame_id" value="camera_link" />
        <param name="camera_info_url" value="file://$(find go2_vision_charging)/config/camera_info.yaml" />
        <param name="width" value="1920" />
        <param name="height" value="1080" />
    </node>
    
    <!-- ⚠️ 重要：删除了手动的 map->base_link 静态TF -->
    <!-- SLAM系统（Fast-LIO + PGO）会自动发布 map->odom->base_link 链路 -->
    
    <!-- 🔧 相机外参静态TF：base_link -> camera_link -->
    <!-- 参数格式：x y z yaw pitch roll (单位：米和弧度) -->
    <!-- ⚠️ 需要根据实际安装位置测量并修改以下参数 -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_cam" 
          args="0.1 0 0.616 -1.5707 0 -1.5707 base_link camera_link" />
    
    <!-- ArUco二维码检测节点 -->
    <node pkg="aruco_ros" type="single" name="aruco_single" output="screen">
        <remap from="/camera_info" to="/camera/camera_info" />
        <remap from="/image" to="/camera/image_raw" />
        <param name="image_is_rectified" value="true"/>
        <param name="marker_size" value="0.184"/>
        <param name="marker_id" value="88"/>
        <param name="dictionary" value="DICT_6X6_250"/>
        <param name="reference_frame" value="camera_link"/>
        <param name="camera_frame" value="camera_link"/>
        <param name="marker_frame" value="aruco_marker_frame" />
    </node>

    <!-- 位姿卡尔曼滤波节点 -->
    <node pkg="go2_vision_charging" type="pose_filter.py" name="pose_filter" output="screen">
        <remap from="/aruco_pose_raw" to="/aruco_single/pose" />
    </node>

    <!-- 🔧 充电目标坐标转换节点（修正版） -->
    <node pkg="go2_vision_charging" type="charging_pose_transformer.py" name="charging_pose_transformer" output="screen">
        <param name="use_map_frame" value="false" />
    </node>

    <!-- 视觉伺服控制节点（修正版） -->
    <node pkg="go2_vision_charging" type="visual_servo_controller.py" name="visual_servo_controller" output="screen" />

    <!-- 充电状态机 -->
    <node pkg="go2_vision_charging" type="charging_state_machine.py" name="charging_state_machine" output="screen" />

</launch>