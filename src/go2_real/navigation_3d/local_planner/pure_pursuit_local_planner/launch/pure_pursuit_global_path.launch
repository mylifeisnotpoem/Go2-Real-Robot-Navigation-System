<?xml version="1.0"?>
<launch>
    <!-- 纯跟踪局部规划器 - 直接跟踪全局路径模式 -->
    <node pkg="pure_pursuit_local_planner" type="pure_pursuit_local_planner_node" name="pure_pursuit_local_planner" output="screen">
        <!-- 从配置文件加载基本参数 -->
        <rosparam file="$(find pure_pursuit_local_planner)/config/planner_config.yaml" command="load" />
        
        <!-- 明确设置为直接跟踪全局路径 -->
        <param name="enable_local_replanning" value="false" />
        <param name="use_smoothed_path" value="false" />
        
        <!-- Pure Pursuit 参数 -->
        <param name="lookahead_distance_min" value="1.0" />
        <param name="lookahead_distance_max" value="3.0" />
        <param name="goal_tolerance" value="0.2" />
        
        <!-- 速度参数 -->
        <param name="max_linear_velocity" value="1.0" />
        <param name="max_angular_velocity" value="1.0" />
        <param name="control_frequency" value="20.0" />
        
        <!-- 重映射话题 -->
        <remap from="global_path" to="/move_base/GlobalPlanner/plan" />
        <remap from="cmd_vel" to="/cmd_vel" />
        <remap from="odom" to="/odom" />
    </node>
    
    <arg name="use_rviz" default="false" />
    
    <!-- RViz可视化（可选） -->
    <group if="$(arg use_rviz)">
        <node name="rviz" pkg="rviz" type="rviz" args="-d $(find pure_pursuit_local_planner)/rviz/pure_pursuit.rviz" />
    </group>
</launch>
