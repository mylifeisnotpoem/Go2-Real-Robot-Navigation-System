<launch>
<!-- Launch file for Livox AVIA LiDAR -->

	<arg name="rviz" default="false" />

	<rosparam command="load" file="$(find fast_lio_slam)/config/localization_mid360.yaml" />

	<param name="feature_extract_enable" type="bool" value="0"/>
	<param name="point_filter_num" type="int" value="1"/>
	<param name="max_iteration" type="int" value="3" />
	<param name="filter_size_surf" type="double" value="0.5" />
	<param name="filter_size_map" type="double" value="0.5" />
	<param name="cube_side_length" type="double" value="1000" />
	<param name="runtime_pos_log_enable" type="bool" value="0" />
	<param name="pcd_save_en" type="bool" value="0" />
    <node pkg="fast_lio_slam" type="fastlio_mapping" name="laserMapping"/>
	

	<arg name="map" default="" />
	<!-- loalization-->
    <node pkg="fast_lio_slam" type="global_localization.py" name="global_localization" output="screen"/>

	<!-- transform  fusion-->
    <node pkg="fast_lio_slam" type="transform_fusion.py" name="transform_fusion" output="screen" launch-prefix="python3"/>

	<!-- glbal map-->
	<node pkg="pcl_ros" type="pcd_to_pointcloud" name="map_publishe" output="screen"
		  args="$(find fast_lio_slam)/PCD/P1_P2.pcd  5 _frame_id:=map cloud_pcd:=/map" />


	<group if="$(arg rviz)">
	<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio_slam)/rviz_cfg/localization.rviz" />
	</group>

</launch>
