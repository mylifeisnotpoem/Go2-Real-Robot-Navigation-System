<?xml version="1.0"?>
<launch>
    <!-- 加载参数文件 -->
    <rosparam file="$(find pgo)/config/params.yaml" command="load"/>
    <rosparam file="$(find pgo)/config/pgo_params.yaml" command="load"/>
    
    <!-- 启动PGO节点 -->
    <node pkg="pgo" type="pgo_node" name="pgo_node" output="screen" >
    </node>
    

    <!-- 可视化 -->
    <node pkg="rviz" type="rviz" name="rviz" 
          args="-d $(find pgo)/rviz/pgo.rviz" /> 
</launch>